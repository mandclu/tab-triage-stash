{
  "manifest_version": 3,
  "name": "Tab Triage & Stash",
  "version": "0.1.0",
  "description": "Prioritize the tabs eating your RAM, then stash them without losing them.",
  "permissions": ["tabs", "tabGroups", "bookmarks", "storage"],
  "optional_permissions": ["processes"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Tab Triage"
  },
  "commands": {
    "open_report": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "Open the Tab Triage report"
    }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
